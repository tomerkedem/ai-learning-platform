# תבנית סביבה ל"מעבדת המילים" (פרק 4, Behind the Scenes AI).
# העתיקו לקובץ .env.local (שמוחרג מ-git) ומלאו את המפתח האמיתי.
#   cp .env.local.example .env.local
#
# אם ANTHROPIC_API_KEY מוגדר -> המעבדה במצב "חי": טקסט חופשי מנותח על ידי Claude.
# אם הוא חסר -> המעבדה במצב "דמו": רק התרחישים המתוסרטים פעילים (בלי שגיאה).
ANTHROPIC_API_KEY=sk-ant-REPLACE-WITH-YOUR-KEY

# מודל המנוע החי. ברירת המחדל בקוד: claude-haiku-4-5-20251001
# (מזהה דָּטֶה יציב, מהיר ~2-3 שניות - מתאים להקלדה אינטראקטיבית).
# שדרוג לאיכות גבוהה יותר אך איטית (~20 שניות): claude-opus-4-8
# WORD_ENGINE_MODEL=claude-haiku-4-5-20251001
